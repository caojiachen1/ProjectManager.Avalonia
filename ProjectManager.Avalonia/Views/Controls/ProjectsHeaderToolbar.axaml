<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="ProjectManager.Avalonia.Views.Controls.ProjectsHeaderToolbar"
             x:CompileBindings="False">

    <Grid Margin="24,0,24,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Search box + Status filter -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <!-- Search TextBox with icon -->
            <Grid Width="280" VerticalAlignment="Center">
                <TextBox Name="SearchTextBox" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="{DynamicResource Toolbar_SearchProjects}"
                         Padding="8,6,32,6"/>
                <icons:SymbolIcon Symbol="Search" FontSize="14" IconVariant="Regular"
                           Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Status filter ComboBox -->
            <ComboBox Name="StatusFilterComboBox"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                      MinWidth="80"/>
        </StackPanel>

        <!-- Right: Action buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <!-- New Project button (primary blue, matches statusButton style) -->
            <Button Classes="statusButton"
                    Background="#005FB8"
                    Command="{Binding CreateProjectCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:SymbolIcon Symbol="Add" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Toolbar_NewProject}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Clone from Git button -->
            <Button Command="{Binding CloneFromGitCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:SymbolIcon Symbol="Branch" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource AddProject_CloneFrom}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Refresh button -->
            <Button Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{DynamicResource Toolbar_RefreshTooltip}"
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Toolbar_Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
