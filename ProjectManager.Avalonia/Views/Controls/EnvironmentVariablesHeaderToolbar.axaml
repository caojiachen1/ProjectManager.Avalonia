<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="ProjectManager.Avalonia.Views.Controls.EnvironmentVariablesHeaderToolbar"
             x:CompileBindings="False">

    <Border Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

            <!-- Search TextBox -->
            <Grid Width="260" VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="{DynamicResource EnvVars_SearchPlaceholder}"
                         Padding="8,6,32,6"/>
                <icons:SymbolIcon Symbol="Search" FontSize="14" IconVariant="Regular"
                           Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Filter ComboBox -->
            <ComboBox SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                      Width="140" VerticalAlignment="Center">
                <ComboBoxItem Content="{DynamicResource EnvVars_FilterAll}"/>
                <ComboBoxItem Content="{DynamicResource EnvVars_FilterUser}"/>
                <ComboBoxItem Content="{DynamicResource EnvVars_FilterSystem}"/>
            </ComboBox>

            <!-- Separator -->
            <Border Width="1" Height="24"
                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                    Margin="4,0"/>

            <!-- Add User Variable button -->
            <Button Command="{Binding AddUserVariableCommand}"
                    ToolTip.Tip="{DynamicResource EnvVars_AddUserTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:SymbolIcon Symbol="People" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource EnvVars_AddUser}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Add System Variable button -->
            <Button Command="{Binding AddSystemVariableCommand}"
                    ToolTip.Tip="{DynamicResource EnvVars_AddSystemTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:SymbolIcon Symbol="Shield" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource EnvVars_AddSystem}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Refresh button -->
            <Button Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{DynamicResource EnvVars_RefreshTooltip}">
                <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="14"
                           VerticalAlignment="Center"/>
            </Button>

        </StackPanel>
    </Border>
</UserControl>
