<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Avalonia.FluentIcons"
             xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Pages"
             xmlns:models="using:ProjectManager.Avalonia.Models"
             xmlns:controls="using:ProjectManager.Avalonia.Views.Controls"
             xmlns:behaviors="using:ProjectManager.Avalonia.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Avalonia.Views.Pages.ProjectsPage"
             x:CompileBindings="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="{DynamicResource Nav_Projects}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Projects_Subtitle}" FontSize="13" Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 工具栏：搜索、状态过滤、新建/克隆/刷新按钮 -->
        <controls:ProjectsHeaderToolbar Grid.Row="1" DataContext="{Binding}"/>

        <!-- Project cards list -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasProjects}">
            <ItemsControl ItemsSource="{Binding FilteredProjects}"
                          Margin="24,12"
                          behaviors:DragDropReorder.Enable="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Project Card (matching WPF original layout) -->
                        <Border Margin="0,4,4,0" Padding="14,16" Width="450" MaxHeight="380"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Drag handle + Project name + 3-dot menu -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag handle (fa-grip-vertical) -->
                                    <Border Grid.Column="0"
                                            Width="28" Height="28" Margin="0,0,8,0"
                                            Background="Transparent"
                                            ToolTip.Tip="{DynamicResource Projects_DragToSort}"
                                            Cursor="SizeAll"
                                            behaviors:DragDropReorder.IsDragHandle="True">
                                        <icons:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="22"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Project name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="18" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}"/>

                                    <!-- 3-dot dropdown menu (vertical, matches WPF MoreVertical20) -->
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Width="32" Height="32" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Click="MenuButton_Click">
                                        <icons:SymbolIcon Symbol="MoreVertical20" FontSize="20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="RightEdgeAlignedTop">
                                                <MenuItem Header="{DynamicResource Projects_OpenInExplorer}"
                                                          Click="MenuOpenInExplorer_Click">
                                                    <MenuItem.Icon>
                                                        <icons:SymbolIcon Symbol="Folder24" FontSize="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource Projects_DeleteProject}"
                                                          Click="MenuDeleteProject_Click">
                                                    <MenuItem.Icon>
                                                        <icons:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="Red"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Row 1: Description -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" Opacity="0.8"
                                           Margin="0,0,0,8" MaxHeight="120"/>

                                <!-- Row 2: Status badge + Git info + Framework + Plugin button -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
                                    <!-- Status Badge -->
                                    <Border CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBadgeConverter}}">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="White"/>
                                    </Border>

                                    <!-- Git info (visible when project has Git repo) -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                IsVisible="{Binding GitInfo.IsGitRepository}">
                                        <icons:SymbolIcon Symbol="Branch24" FontSize="12" Foreground="Green"
                                                           VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GitInfo.CurrentBranch}" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Framework name -->
                                    <TextBlock Text="{Binding Framework, Converter={StaticResource FrameworkToLocalizedNameConverter}}"
                                               Opacity="0.6" VerticalAlignment="Center"/>

                                    <!-- ComfyUI plugin management button -->
                                    <Button Width="28" Height="28" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip.Tip="{DynamicResource Projects_ManageComfyUIPlugins}"
                                            Command="{Binding $parent[UserControl].DataContext.ManageComfyUIPluginsCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding Framework, Converter={StaticResource ComfyUIFrameworkToVisibilityConverter}}">
                                        <icons:SymbolIcon Symbol="PuzzlePiece24" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <!-- Row 3: Local path -->
                                <TextBlock Grid.Row="3"
                                           Text="{Binding LocalPath}"
                                           FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>

                                <!-- Row 4: Last modified -->
                                <TextBlock Grid.Row="4"
                                           Text="{Binding LastModifiedDisplay}"
                                           FontSize="11" Opacity="0.5"
                                           Margin="0,0,0,8"/>

                                <!-- Row 5: Spacer -->
                                <Grid Grid.Row="5"/>

                                <!-- Row 6: Action buttons -->
                                <WrapPanel Grid.Row="6" Orientation="Horizontal">
                                    <!-- Toggle (Start/Stop) button -->
                                    <Button Margin="0,0,4,4"
                                            Classes="statusButton"
                                            Background="{Binding Status, Converter={StaticResource StatusToToggleButtonAppearanceConverter}}"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleProjectCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding Status, Converter={StaticResource StatusToToggleButtonEnabledConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToToggleButtonIconConverter}}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToToggleButtonTextConverter}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Git button -->
                                    <Button Margin="0,0,4,4"
                                            Command="{Binding $parent[UserControl].DataContext.ManageGitCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding ., Converter={StaticResource HasGitRepositoryToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:SymbolIcon Symbol="Branch24" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Git" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Environment Variables button -->
                                    <Button Margin="0,0,4,4"
                                            Command="{Binding $parent[UserControl].DataContext.ManageEnvironmentVariablesCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:SymbolIcon Symbol="Settings24" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Projects_EnvVars}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Settings button -->
                                    <Button Margin="0,0,4,4"
                                            Command="{Binding $parent[UserControl].DataContext.EditProjectCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:SymbolIcon Symbol="Options24" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Projects_Settings}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Terminal button -->
                                    <Button Margin="0,0,0,4"
                                            Command="{Binding $parent[UserControl].DataContext.ViewLogsCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:SymbolIcon Symbol="WindowConsole20" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Projects_Terminal}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state overlay -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasProjects, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons"
                       FontSize="64" Opacity="0.3" HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
            <TextBlock Text="{DynamicResource Projects_NoProjects}" FontSize="18" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Projects_NoProjectsDesc}"
                       Opacity="0.4" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="{DynamicResource Projects_NewProject}"
                        Command="{Binding CreateProjectCommand}"
                        Classes="accent"/>
                <Button Content="{DynamicResource AddProject_CloneFrom}"
                        Command="{Binding CloneFromGitCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Refreshing indicator -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                Padding="12,6" CornerRadius="4" Margin="0,8,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                IsVisible="{Binding IsRefreshing}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Projects_Refreshing}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
