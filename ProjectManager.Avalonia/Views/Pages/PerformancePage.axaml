<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Pages"
             xmlns:models="using:ProjectManager.Avalonia.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Avalonia.Views.Pages.PerformancePage"
             x:CompileBindings="False">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,12">

            <!-- Header: Title + Refresh -->
            <Grid Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE9D9;" FontSize="24" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Performance_Title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshNowCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Performance_Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Summary Cards (4 columns, full width like Dashboard) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Running Projects -->
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Performance_RunningProjects}" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RunningProjects}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalProjects, StringFormat='/{0}'}" FontSize="14" Opacity="0.6" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Total CPU Usage -->
                <Border Grid.Column="1" Margin="8,0,8,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Performance_TotalCpuUsage}" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCpuUsage, StringFormat='{}{0:F1}'}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="%" FontSize="18" Opacity="0.7" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: Total Memory Usage -->
                <Border Grid.Column="2" Margin="8,0,8,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Performance_TotalMemoryUsage}" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalMemoryUsageMb, StringFormat='{}{0:F0}'}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="MB" FontSize="14" Opacity="0.7" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Last Update Time -->
                <Border Grid.Column="3" Margin="8,0,0,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Performance_LastUpdate}" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding LastUpdated, StringFormat='{}{0:HH:mm:ss}'}" FontSize="26" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Heartbeat icon + Monitoring status + Progress bar -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#4CAF50" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" VerticalAlignment="Center"/>
                    <ProgressBar Width="80" Height="4" IsIndeterminate="True"
                                 IsVisible="{Binding IsMonitoringActive}"
                                 VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Project Performance Cards -->
            <ItemsControl ItemsSource="{Binding ProjectMetrics}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="20" Margin="0,0,0,12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="8">

                                <!-- Row 1: Header - Project Name + Status + Open Folder -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProjectName}" FontSize="18" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBadgeConverter}}"
                                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Framework, Converter={StaticResource FrameworkToLocalizedNameConverter}}"
                                                   Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[ItemsControl].DataContext.OpenInExplorerCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Performance_OpenFolder}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Row 2: Path + Start Command -->
                                <TextBlock Text="{Binding LocalPath}" FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StartCommand}" FontSize="12" Opacity="0.5"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding StartCommand, Converter={StaticResource StringToVisibilityConverter}}"/>

                                <!-- Row 3: Metrics - using horizontal StackPanel for proper collapse -->
                                <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,4,0,0">

                                    <!-- CPU -->
                                    <StackPanel MinWidth="120">
                                        <TextBlock Text="CPU" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:F1}'}"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="%" FontSize="14" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                        <ProgressBar Value="{Binding CpuUsagePercent}" Maximum="100"
                                                     Height="4" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left"
                                                     Foreground="#2196F3"/>
                                    </StackPanel>

                                    <!-- GPU (conditional on global HasGpuData) -->
                                    <StackPanel MinWidth="120"
                                                IsVisible="{Binding $parent[ItemsControl].DataContext.HasGpuData}">
                                        <TextBlock Text="GPU" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{Binding GpuUsagePercent, Converter={StaticResource NullableToDoubleConverter}, StringFormat='{}{0:F1}'}"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="%" FontSize="14" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                        <ProgressBar Value="{Binding GpuUsagePercent, Converter={StaticResource NullableToDoubleConverter}}"
                                                     Maximum="100"
                                                     Height="4" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left"
                                                     Foreground="#FF9800"/>
                                    </StackPanel>

                                    <!-- Memory -->
                                    <StackPanel MinWidth="120">
                                        <TextBlock Text="{DynamicResource Performance_MemoryShort}" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding MemoryUsageMb, StringFormat='{}{0:F1}'}"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="MB" FontSize="12" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Threads -->
                                    <StackPanel MinWidth="100">
                                        <TextBlock Text="{DynamicResource Performance_Threads}" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ThreadCount}"
                                                   FontSize="20" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Row 4: Process Info -->
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- PID -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Performance_PID}" Opacity="0.5" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ProcessId, TargetNullValue='--'}"
                                                       FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>

                                        <!-- Start Time -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Performance_StartTime}" Opacity="0.5" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ProcessStartTime, StringFormat='{}{0:MM-dd HH:mm}', TargetNullValue='--'}"
                                                       FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>

                                        <!-- Uptime -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Performance_Uptime}" Opacity="0.5" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Uptime, Converter={StaticResource TimeSpanToStringConverter}}"
                                                       FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
