<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProjectManager.Avalonia.Views.Pages.AddProjectPage"
             xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Pages"
             x:DataType="vm:AddProjectViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 页面标题 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{DynamicResource AddProject_Title}" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource AddProject_PageDesc}" FontSize="14" Opacity="0.7"/>
            </StackPanel>

            <!-- 添加方式选择 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 新建项目 -->
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontSize="64" Opacity="0.6" Margin="0,0,0,16"
                                   HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons"/>
                        <TextBlock Text="{DynamicResource AddProject_NewTitle}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource AddProject_NewDesc}"
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,0,0,16"/>
                        <Button Content="{DynamicResource AddProject_CreateNew}"
                                Command="{Binding CreateNewProjectCommand}"
                                Classes="statusButton"
                                Background="#005FB8"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Git克隆 -->
                <Border Grid.Column="1" Margin="8,0,0,0" Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xf126;" FontSize="64" Opacity="0.6" Margin="0,0,0,16"
                                   HorizontalAlignment="Center" FontFamily="{StaticResource FontAwesomeSolid}"/>
                        <TextBlock Text="{DynamicResource AddProject_CloneTitle}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource AddProject_CloneDesc}"
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,0,0,16"/>
                        <Button Content="{DynamicResource AddProject_CloneFrom}"
                                Command="{Binding CloneFromGitCommand}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
