<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProjectManager.Avalonia.Views.Pages.DashboardPage"
             xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Pages"
             xmlns:models="using:ProjectManager.Avalonia.Models"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:DataType="vm:DashboardViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题（固定置顶） -->
        <StackPanel Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="{DynamicResource Nav_Dashboard}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Dashboard_Subtitle}" FontSize="13" Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 可滚动内容 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,0,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 统计卡片 -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 总项目数 -->
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
                            <icons:SymbolIcon Symbol="AppsListDetail" FontSize="24" Opacity="0.7"/>
                            <TextBlock Text="{DynamicResource Dashboard_TotalProjects}" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalProjects}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- 运行中项目 -->
                <Border Grid.Column="1" Margin="8,0,8,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
                            <icons:SymbolIcon Symbol="Play" FontSize="24" Foreground="Green" IconVariant="Filled"/>
                            <TextBlock Text="{DynamicResource Dashboard_Running}" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RunningProjects}" FontSize="28" FontWeight="Bold" Foreground="Green"/>
                    </StackPanel>
                </Border>

                <!-- 已停止项目 -->
                <Border Grid.Column="2" Margin="8,0,8,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
                            <icons:SymbolIcon Symbol="Stop" FontSize="24" Opacity="0.7" IconVariant="Filled"/>
                            <TextBlock Text="{DynamicResource Dashboard_Stopped}" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StoppedProjects}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- 错误项目 -->
                <Border Grid.Column="3" Margin="8,0,0,0" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
                            <icons:SymbolIcon Symbol="ErrorCircle" FontSize="24" Foreground="Red"/>
                            <TextBlock Text="{DynamicResource Dashboard_Error}" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorProjects}" FontSize="28" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快速操作 -->
            <Border Grid.Row="1" Padding="16" Margin="0,0,0,24"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard_QuickActions}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding CreateProjectCommand}"
                                Classes="statusButton"
                                Background="#005FB8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:SymbolIcon Symbol="Add" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Dashboard_NewProject}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GitCloneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:SymbolIcon Symbol="Branch" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Dashboard_GitClone}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ViewAllProjectsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:SymbolIcon Symbol="AppsListDetail" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Dashboard_ViewAllProjects}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopAllProjectsCommand}"
                                Classes="caution">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:SymbolIcon Symbol="Stop" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Dashboard_StopAllProjects}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 最近项目 -->
            <Border Grid.Row="2" Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard_RecentProjects}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Project">
                                <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,8"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12"/>
                                            <TextBlock Text="{Binding LastModifiedDisplay}" Opacity="0.5" FontSize="11"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{Binding Status, Converter={StaticResource StatusToBadgeConverter}}"
                                                CornerRadius="4" Padding="8,2"
                                                Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="12"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <Button Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).StartProjectCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Status, Converter={StaticResource StatusToStartEnabledConverter}}"
                                                    ToolTip.Tip="{DynamicResource Dashboard_StartProject}">
                                                <icons:SymbolIcon Symbol="Play" FontSize="14" IconVariant="Filled"/>
                                            </Button>
                                            <Button Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).StopProjectCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Status, Converter={StaticResource StatusToStopEnabledConverter}}"
                                                    ToolTip.Tip="{DynamicResource Dashboard_StopProject}">
                                                <icons:SymbolIcon Symbol="Stop" FontSize="14" IconVariant="Filled"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
