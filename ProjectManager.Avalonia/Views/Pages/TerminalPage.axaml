<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Pages"
             xmlns:models="using:ProjectManager.Avalonia.Models"
             xmlns:behaviors="using:ProjectManager.Avalonia.Behaviors"
             xmlns:helpers="using:ProjectManager.Avalonia.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Avalonia.Views.Pages.TerminalPage"
             x:CompileBindings="False"
             x:Name="PageRoot">

    <UserControl.Resources>
        <helpers:BoolToTabBackgroundConverter x:Key="BoolToTabBackgroundConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Page Title -->
            <RowDefinition Height="Auto"/>
            <!-- Top toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Terminal area -->
            <RowDefinition Height="*"/>
            <!-- Bottom status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <StackPanel Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="{DynamicResource Nav_Terminal}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Terminal_Subtitle}" FontSize="13" Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===================== Top Toolbar ===================== -->
        <Border Grid.Row="1" Background="#2D2D30"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                Padding="12,8" Margin="24,0,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding StartTerminalCommand}"
                            ToolTip.Tip="{DynamicResource Terminal_StartTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Terminal_Start}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopTerminalCommand}"
                            ToolTip.Tip="{DynamicResource Terminal_StopTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Terminal_Stop}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearOutputCommand}"
                            ToolTip.Tip="{DynamicResource Terminal_ClearTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Terminal_Clear}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshSessionsCommand}"
                            ToolTip.Tip="{DynamicResource Terminal_RefreshTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Terminal_Refresh}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenCmdCommand}"
                            ToolTip.Tip="{DynamicResource Terminal_OpenCmdTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Terminal_OpenCmd}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status Display -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4"
                            IsVisible="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{DynamicResource Terminal_Status}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSession.StatusDisplay, FallbackValue='--'}"
                               Foreground="{Binding SelectedSession.IsRunning, Converter={StaticResource BooleanToColorConverter}, FallbackValue=Gray}"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Terminal_Project}" Foreground="#CCCCCC" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSession.ProjectName, FallbackValue='--'}"
                               Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Center: Terminal Area ===================== -->
        <Grid Grid.Row="2" Margin="24,0,24,0">

            <!-- Terminal sessions container -->
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding TerminalSessions.Count, Converter={StaticResource CountToVisibilityConverter}}">

                <!-- Custom Fluent Design tab bar -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6,6,0,0">
                    <ItemsControl ItemsSource="{Binding TerminalSessions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="2,0" Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                         Command="{Binding DataContext.SelectSessionCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}">
                                    <Button.Theme>
                                        <ControlTheme TargetType="Button">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Border Name="Root"
                                                            Background="{Binding IsSelected, Converter={StaticResource BoolToTabBackgroundConverter}}"
                                                            BorderBrush="#B0B0B0"
                                                            BorderThickness="0.5,0.5,0.5,0"
                                                            CornerRadius="4,4,0,0"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter>
                                            <Style Selector="^:pointerover /template/ Border#Root">
                                                <Setter Property="Background" Value="#555555"/>
                                            </Style>
                                        </ControlTheme>
                                    </Button.Theme>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,6">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   Foreground="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProjectName}" FontSize="12"
                                                   Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <Button Content="&#xE711;"
                                                FontFamily="Segoe Fluent Icons" FontSize="9"
                                                Width="18" Height="18"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                 Command="{Binding DataContext.CloseSessionCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{DynamicResource Terminal_CloseSession}">
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button">
                                                    <Setter Property="Template">
                                                        <ControlTemplate>
                                                            <Border Name="CloseRoot"
                                                                    Background="Transparent"
                                                                    CornerRadius="3"
                                                                    Width="{TemplateBinding Width}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  Foreground="#666666"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter>
                                                    <Style Selector="^:pointerover /template/ Border#CloseRoot">
                                                        <Setter Property="Background" Value="#30FFFFFF"/>
                                                    </Style>
                                                    <Style Selector="^:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                    </Style>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Terminal content for selected session -->
                <Border Grid.Row="1" Background="#0C0C0C">
                    <ScrollViewer Background="#0C0C0C"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Padding="8,8,16,24"
                                             FontFamily="Consolas,Courier New,monospace"
                                             FontSize="18"
                                             TextWrapping="Wrap"
                                             Foreground="#CCCCCC"
                                             behaviors:AnsiTextBehavior.ItemsSource="{Binding SelectedSession.OutputLines}"
                                             behaviors:AnsiTextBehavior.EnableAnsiParsing="True"
                                             behaviors:AnsiTextBehavior.AutoScroll="True"
                                             behaviors:AnsiTextBehavior.MaxItems="5000">
                            <SelectableTextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="{DynamicResource Terminal_CopyAll}" Click="CopyAll_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Terminal_Clear}" Click="ClearOutput_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </SelectableTextBlock.ContextFlyout>
                        </SelectableTextBlock>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Empty state: shown when no terminal sessions exist -->
            <Border Background="#0C0C0C"
                    IsVisible="{Binding TerminalSessions.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Opacity="0.6">
                    <TextBlock Text="&#xE756;"
                               FontFamily="Segoe Fluent Icons" FontSize="48"
                               Foreground="#666666" HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource Terminal_NoSession}"
                               FontSize="16" Foreground="#666666"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Terminal_NoSessionHint}"
                               FontSize="12" Foreground="#999999"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                </Panel>
            </Border>

            <!-- Loading overlay -->
            <Border Background="#80000000"
                    IsVisible="{Binding IsLoading}"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="200"/>
                    <TextBlock Text="{DynamicResource Common_Loading}" Foreground="#FFFFFF" FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Floating scroll buttons -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,24,24" Spacing="4">
                <Button Click="ScrollToTop_Click"
                        Padding="8" Opacity="0.8"
                        ToolTip.Tip="{DynamicResource Terminal_ScrollTop}"
                        Background="#40000000" BorderThickness="0">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#CCCCCC"/>
                </Button>
                <Button Click="ScrollToBottom_Click"
                        Padding="8" Opacity="0.8"
                        ToolTip.Tip="{DynamicResource Terminal_ScrollBottom}"
                        Background="#40000000" BorderThickness="0">
                    <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#CCCCCC"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Bottom Status Bar ===================== -->
        <Border Grid.Row="3" Background="#2D2D30"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,0"
                Padding="12,6" Margin="24,0,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Working directory -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource Terminal_WorkingDir}" Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSession.ProjectPath, FallbackValue='--'}"
                               Foreground="#FFFFFF" FontFamily="Consolas,Courier New,monospace"
                               FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>

                <!-- Start time + Session count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource Terminal_StartTime}" Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSession.StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', FallbackValue='--'}"
                               Foreground="#FFFFFF" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Terminal_SessionCount}" Foreground="#CCCCCC"
                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TerminalSessions.Count}"
                               Foreground="#FFFFFF" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
