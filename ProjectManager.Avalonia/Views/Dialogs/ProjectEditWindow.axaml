<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Dialogs"
        x:Class="ProjectManager.Avalonia.Views.Dialogs.ProjectEditWindow"
        x:CompileBindings="False"
        Title="{DynamicResource ProjectEdit_Title}"
        Width="600" Height="720"
        MinWidth="500" MinHeight="550"
        Background="#202020"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True">

    <Border Padding="24"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource ProjectEdit_EditProjectHeader}"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,16"
                       IsVisible="{Binding IsEditing}"/>
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource NewProject_Title}"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,16"
                       IsVisible="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!-- Project Name -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Generic_ProjectName}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ProjectName}" PlaceholderText="{DynamicResource Generic_ProjectNamePlaceholder}"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource ProjectSettings_Description}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ProjectDescription}" PlaceholderText="{DynamicResource NewProject_ProjectDescPlaceholder}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                    </StackPanel>

                    <!-- Local Path -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Generic_LocalPath}" FontWeight="Medium"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LocalPath}"
                                     PlaceholderText="{DynamicResource Generic_LocalPathPlaceholder}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Button_Browse}" Margin="8,0,0,0"
                                    Command="{Binding BrowseLocalPathCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Working Directory -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Generic_WorkingDirectory}" FontWeight="Medium"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WorkingDirectory}"
                                     PlaceholderText="{DynamicResource Generic_WorkingDirectoryPlaceholder}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Button_Browse}" Margin="8,0,0,0"
                                    Command="{Binding BrowseWorkingDirectoryCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Framework -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource ProjectSettings_Framework}" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding AvailableFrameworks}"
                                  SelectedItem="{Binding Framework}"
                                  PlaceholderText="{DynamicResource ProjectEdit_FrameworkPlaceholder}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Start Command -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Generic_StartCommand}" FontWeight="Medium"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding StartCommand}"
                                     PlaceholderText="{DynamicResource Generic_StartCommandPlaceholder}"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="140"
                                      ItemsSource="{Binding FrameworkCommands}"
                                      PlaceholderText="{DynamicResource ProjectEdit_TemplatesPlaceholder}"
                                      SelectionChanged="FrameworkCommand_SelectionChanged"/>
                        </Grid>
                    </StackPanel>

                    <!-- Auto Start -->
                    <CheckBox Content="{DynamicResource Generic_AutoStart}"
                              IsChecked="{Binding AutoStart}"/>

                    <!-- Tags -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Generic_Tags}" FontWeight="Medium"/>
                        <TextBox Text="{Binding TagsString}"
                                 PlaceholderText="{DynamicResource Generic_TagsPlaceholder}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="0,16,0,0">
                <Button Content="{DynamicResource Button_Delete}"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        Classes="caution"/>
                <Button Content="{DynamicResource Button_Cancel}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{DynamicResource Button_Save}"
                        Command="{Binding SaveCommand}"
                        Classes="accent"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
