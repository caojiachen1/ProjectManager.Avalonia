<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectManager.Avalonia.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="ProjectManager.Avalonia.Views.Dialogs.PathTextEditWindow"
        x:CompileBindings="False"
        Title="{DynamicResource PathEditor_TextTitle}"
        Width="600" Height="400"
        MinWidth="500" MinHeight="300"
        Background="#202020"
        FontFamily="{StaticResource NotoSansSC}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True">

    <Design.DataContext>
        <vm:PathTextEditViewModel/>
    </Design.DataContext>

    <Border Background="#202020" Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Description -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource PathEditor_TextDescription}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <!-- Text editor -->
            <TextBox Grid.Row="1"
                     Text="{Binding PathText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="{StaticResource CascadiaCode}"
                     FontSize="12"
                     PlaceholderText="C:\Windows&#x0a;C:\Windows\System32&#x0a;D:\MyTools"/>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{DynamicResource Button_Cancel}"
                        Click="OnCancelClick"
                        MinWidth="80"
                        Padding="20,8"/>
                <Button Content="{DynamicResource Button_Confirm}"
                        Click="OnSaveClick"
                        Classes="accent"
                        MinWidth="80"
                        Padding="20,8"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
